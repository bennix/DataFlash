{
  "id": "140-hr-attrition",
  "title": "员工流失清洗分析",
  "title_en": "HR Attrition Clean & Analyze",
  "description": "预置模板：脏员工调研表 → AI 规范化部门/远程字段并填补缺失 → 筛流失员工 → 描述统计与对比图 → 报告。适合演示 AI Clean 预填意图。",
  "description_en": "Starter: messy employee survey → AI normalize dept/remote and fill gaps → filter attrition → stats & chart → report. Showcases prefilled AI Clean intents.",
  "dataset": "employee_survey.csv",
  "graph": {
    "format_version": 2,
    "annotations": [
      {
        "type": "text",
        "content": "数据含多余空格与 Y/N 混用；先 AI 清洗再分析流失人群。",
        "content_en": "Data has stray spaces and mixed Y/N; AI-clean first, then analyze leavers.",
        "position": {
          "x": 40,
          "y": 20
        }
      }
    ],
    "nodes": [
      {
        "id": "n_file",
        "type": "file_input",
        "position": {
          "x": 40,
          "y": 120
        },
        "data": {
          "label": "员工调研",
          "label_en": "Employee survey",
          "params": {
            "path": "{{DATASET_PATH}}"
          }
        }
      },
      {
        "id": "n_clean",
        "type": "ai_clean",
        "position": {
          "x": 280,
          "y": 120
        },
        "data": {
          "label": "规范化字段",
          "label_en": "Normalize fields",
          "params": {
            "intent": "将 dept 去空格并统一为短中文名；remote 的 Y/Yes/y/yes→True、N/No/n/no→False；tenure_years 与 satisfaction 缺失用各自中位数填充；attrition 统一为 Yes/No",
            "intent_en": "Strip/normalize dept; map remote Y/Yes/y→True and N/No/n→False; fill tenure_years and satisfaction nulls with medians; normalize attrition to Yes/No",
            "model": "anthropic/claude-sonnet-4.6"
          }
        }
      },
      {
        "id": "n_filter",
        "type": "filter",
        "position": {
          "x": 520,
          "y": 120
        },
        "data": {
          "label": "流失员工",
          "label_en": "Attrition = Yes",
          "params": {
            "expression": "attrition == 'Yes'",
            "ai_intent": "只保留 attrition 为 Yes 的员工",
            "ai_intent_en": "Keep only employees with attrition == Yes"
          }
        }
      },
      {
        "id": "n_analyze",
        "type": "ai_analyze",
        "position": {
          "x": 760,
          "y": 40
        },
        "data": {
          "label": "流失画像",
          "label_en": "Leaver profile",
          "params": {
            "intent": "对流失员工做描述统计：部门分布、tenure_years、satisfaction、salary 的均值/分位，并与常见流失信号对照",
            "intent_en": "Profile leavers: dept mix, tenure_years/satisfaction/salary mean and quartiles, note common attrition signals",
            "model": "anthropic/claude-sonnet-4.6"
          }
        }
      },
      {
        "id": "n_chart",
        "type": "ai_chart",
        "position": {
          "x": 760,
          "y": 220
        },
        "data": {
          "label": "满意度×薪资",
          "label_en": "Satisfaction × salary",
          "params": {
            "x": "satisfaction",
            "y": "salary",
            "color": "dept",
            "intent": "散点图：流失员工的 satisfaction vs salary，按 dept 着色",
            "intent_en": "Scatter of satisfaction vs salary for leavers, colored by dept",
            "model": "anthropic/claude-sonnet-4.6"
          }
        }
      },
      {
        "id": "n_report",
        "type": "ai_report",
        "position": {
          "x": 1000,
          "y": 120
        },
        "data": {
          "label": "流失简报",
          "label_en": "Attrition brief",
          "params": {
            "intent": "撰写员工流失简报：样本量、高风险部门、满意度与薪资关系、可执行的保留建议（2–3 条）",
            "intent_en": "Write an attrition brief: sample size, high-risk depts, satisfaction–salary pattern, and 2–3 retention actions",
            "model": "anthropic/claude-opus-5"
          }
        }
      },
      {
        "id": "n_export",
        "type": "export",
        "position": {
          "x": 1240,
          "y": 120
        },
        "data": {
          "label": "导出 PDF",
          "label_en": "Export PDF",
          "params": {
            "format": "pdf",
            "path": "{{EXPORT_PATH}}"
          }
        }
      }
    ],
